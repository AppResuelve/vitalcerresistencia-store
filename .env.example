# URL del API multitenant de misitioapp
NEXT_PUBLIC_API_URL=http://localhost:3001

# Slug del tenant al que pertenece esta store (obligatorio)
# En producción puede omitirse si se resuelve por hostname.
NEXT_PUBLIC_TENANT_SLUG=vitalcerresistencia

# URL pública de esta store (para SEO, OG images, sitemap)
NEXT_PUBLIC_STORE_URL=http://localhost:3000
